# В корневой папке проекта создайте файл .env
cat > .env << 'EOF'
# ТЕЛЕГРАМ БОТ
TELEGRAM_BOT_TOKEN=ВАШ_TELEGRAM_БОТ_ТОКЕН_ЗДЕСЬ

# ЮKASSA (ТЕСТОВЫЙ РЕЖИМ - для разработки)
YOOKASSA_SHOP_ID=1262862
YOOKASSA_SECRET_KEY=test_ваш_тестовый_ключ

# НЕ ИСПОЛЬЗУЙТЕ ПРОДАКШЕН КЛЮЧ В .env ФАЙЛЕ!
# YOOKASSA_SECRET_KEY=live_ваш_продакшен_ключ_здесь
EOF
